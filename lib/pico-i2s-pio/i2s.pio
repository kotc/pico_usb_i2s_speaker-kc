;i2s BCLK64fs MCLK256fs
.program i2s_mclk
set pins, 0
set pins, 1



;i2s BCLK64fs MCLK NO
.program i2s_data
.side_set 2
;                      /--BCLK
;                      |/-LRCLK
;                      ||
pull block      side 0b10

out pins, 1     side 0b00
set x, 29       side 0b10

L1:
out pins, 1     side 0b00
jmp x--, L1     side 0b10

out pins, 1     side 0b01
pull block      side 0b11

out pins, 1     side 0b01
set x, 29       side 0b11

L2:
out pins, 1     side 0b01
jmp x--, L2     side 0b11

out pins, 1     side 0b00


;lsbj16
.program i2s_pt8211
.side_set 2
;                      /--BCK
;                      |/-WS
;                      ||
pull block      side 0b10 [1]

out pins, 1     side 0b01 [1]
set x, 13       side 0b11 [1]

L1:
out pins, 1     side 0b01 [1]
jmp x--, L1     side 0b11 [1]

out pins, 1     side 0b01 [1]
pull block      side 0b11 [1]

out pins, 1     side 0b00 [1]
set x, 13       side 0b10 [1]

L2:
out pins, 1     side 0b00 [1]
jmp x--, L2     side 0b10 [1]

out pins, 1     side 0b00 [1]


;i2s BCLK32fs AK449X EXDF
.program i2s_exdf_a
.side_set 3
;                      /---MCLK
;                      |/--BCK
;                      ||/-WCK
;                      |||
pull block      side 0b111 [1]

out pins, 1     side 0b000 [1]
set x, 13       side 0b110 [1]

L1:
out pins, 1     side 0b000 [1]
jmp x--, L1     side 0b110 [1]

out pins, 1     side 0b000 [1]
nop             side 0b110 [1]

out pins, 1     side 0b001 [1]
set x, 13       side 0b111 [1]

L2:
out pins, 1     side 0b001 [1]
jmp x--, L2     side 0b111 [1]

out pins, 1     side 0b001 [1]


;i2s BCLK32fs AK449X EXDF
.program i2s_exdf_b

pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L1:
out pins, 1     [1]
jmp x--, L1     [1]

out pins, 1     [1]
nop             [1]

out pins, 1     [1]
set x, 13       [1]

L2:
out pins, 1     [1]
jmp x--, L2     [1]

out pins, 1     [1]


;i2s BCLK64fs NO MCLK DUAL
.program i2s_data_dual

pull block

out pins, 1
set x, 29

L1:
out pins, 1
jmp x--, L1

out pins, 1
pull block

out pins, 1
set x, 29

L2:
out pins, 1
jmp x--, L2

out pins, 1



;lsbj16_dual
.program i2s_pt8211_dual
;                      /--BCK
;                      |/-WS
;                      ||
pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L1:
out pins, 1     [1]
jmp x--, L1     [1]

out pins, 1     [1]
pull block      [1]

out pins, 1     [1]
set x, 13       [1]

L2:
out pins, 1     [1]
jmp x--, L2     [1]

out pins, 1     [1]


;i2s_slave
.program i2s_slave
; I2S slave transmitter: 64fs BCLK, 32-bit slots, MSB first, 1-bit delay after LRCLK.
;in pin 0   LRCLK  (also JMP_PIN)
;in pin 1   BCLK
;
; Every bit, including both LSBs, is driven on a BCLK *falling* edge, so DOUT is
; stable for about half a BCLK period either side of the rising edge on which the
; receiver latches it, whatever the LRCLK/BCLK skew. (The previous version changed
; DOUT just after the rising edge, leaving only the PIO input-sync latency as hold
; time; a DAC that missed it latched the following bit -> signal-dependent distortion.)
;
; LRCLK is only used to keep frame alignment. It is sampled on the BCLK rising edge
; before each LSB (where it is stable even with LRCLK/BCLK skew of up to ~half a BCLK
; period either way): if it has already changed we are behind (e.g. a TX FIFO underrun
; stalled `pull block`) and the LSB is sent at once to catch up one bit per half-frame;
; if we are ahead, we hold after the LSB until LRCLK changes.
; Words are always pulled L,R,L,R so the channel order can never swap.

; start-up: find the start of a frame
    wait 1 pin 0
    wait 0 pin 0
    wait 0 pin 1
.wrap_target
    pull block              ; L word
    set y 30
L_LOOP:                     ; L bit31..bit1 on falls 1..31
    wait 1 pin 1
    wait 0 pin 1
    out pins 1
    jmp y-- L_LOOP
    wait 1 pin 1            ; rising edge in slot 31 (LRCLK is stable here)
    jmp pin L_LSB           ; LRCLK already high: we are a slot behind, send LSB now
    wait 0 pin 1            ; fall 32
L_LSB:
    out pins 1              ; L LSB
    wait 1 pin 0            ; if we are ahead, hold until LRCLK rises
    pull block              ; R word
    set y 30
R_LOOP:                     ; R bit31..bit1 on falls 33..63
    wait 1 pin 1
    wait 0 pin 1
    out pins 1
    jmp y-- R_LOOP
    wait 1 pin 1            ; rising edge in slot 63 (LRCLK is stable here)
    jmp pin R_ON_TIME       ; LRCLK still high: on time
    jmp R_LSB               ; LRCLK already low: we are a slot behind, send LSB now
R_ON_TIME:
    wait 0 pin 1            ; fall 64 (= slot 0 of next frame)
R_LSB:
    out pins 1              ; R LSB
    wait 0 pin 0            ; if we are ahead, hold until LRCLK falls
.wrap
